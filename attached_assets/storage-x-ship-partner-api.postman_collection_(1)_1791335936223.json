                  ],
                  "path": [
                    "shipments",
                    "{{trackingNumber}}"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"trackingNumber\": \"SXS10394822\",\n  \"changed\": [\"weight_grams\", \"cod_amount_minor\"],\n  \"repriced\": true,\n  \"oldTotalMinor\": \"1800\",\n  \"newTotalMinor\": \"2300\",\n  \"adjustmentMinor\": \"500\"\n}"
            },
            {
              "name": "409 Conflict - already at a hub",
              "originalRequest": {
                "method": "PATCH",
                "url": {
                  "raw": "{{baseUrl}}/shipments/{{trackingNumber}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "shipments",
                    "{{trackingNumber}}"
                  ]
                }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{ \"error\": \"update_failed\", \"message\": \"this shipment has already reached a hub and can no longer be edited by API\" }"
            }
          ]
        },
