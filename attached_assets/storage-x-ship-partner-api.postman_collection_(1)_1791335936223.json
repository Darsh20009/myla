        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments/{{trackingNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "shipments",
                "{{trackingNumber}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weightGrams\": 1200,\n  \"codAmount\": 200,\n  \"reason\": \"Customer added a second item\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send only the fields changing. Only works before the shipment reaches a hub (draft through picked_up) — 409 after that. Changing weight/city/COD reprices an already-charged shipment and posts the difference. codAmount is in riyals; codAmountMinor (halalas) also accepted."
          },
          "response": [
            {
              "name": "200 OK - repriced",
              "originalRequest": {
                "method": "PATCH",
                "url": {
                  "raw": "{{baseUrl}}/shipments/{{trackingNumber}}",
                  "host": [
