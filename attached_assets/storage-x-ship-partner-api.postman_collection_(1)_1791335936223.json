              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"shipmentId\": \"b6e2c9d4-1a2b-4c3d-9e8f-0123456789ab\",\n  \"trackingNumber\": \"SXS10394822\",\n  \"status\": \"awaiting_pickup\",\n  \"externalOrderId\": \"ORD-48213\",\n  \"duplicate\": true\n}"
            },
            {
              "name": "400 Bad Request - bad national address",
              "originalRequest": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/shipments",
                  "host": [
